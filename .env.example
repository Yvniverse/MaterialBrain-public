POSTGRES_DB=pengka_material
POSTGRES_USER=pengka
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
DATABASE_URL=postgresql+psycopg://pengka:CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD@db:5432/pengka_material
ENVIRONMENT=production
COOKIE_SECURE=false
SESSION_HOURS=8
ATTACHMENT_DIR=/storage/attachments
MAX_UPLOAD_MB=20
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
BUSINESS_TIMEZONE=Asia/Shanghai
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE=0 2 * * *
# Persistent file-storage root. Controlled deployment overrides this explicitly.
MATERIALBRAIN_STORAGE_ROOT=./storage
ADMIN_USERNAME=admin
ADMIN_FULL_NAME=系统管理员
# ADMIN_PASSWORD 不建议长期写入 .env；创建管理员时交互输入更安全。

# Warehouse Agent（默认关闭；仅后端读取 Key）
AGENT_ENABLED=false
AGENT_MODEL_POLICY=normal
LLM_PROVIDER=qwen
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3.7-plus-2026-05-26
DASHSCOPE_ENABLE_THINKING=false
DASHSCOPE_MODEL_POOL_ENABLED=true
DASHSCOPE_FALLBACK_MODELS=qwen3.7-max-2026-06-08
DASHSCOPE_CERTIFIED_MODELS=qwen3.7-plus-2026-05-26,qwen3.7-max-2026-06-08
# TypeSafe Jev (server-side only; default off; never put the key in Git/frontend/nginx)
TYPESAFE_API_KEY=
TYPESAFE_API_BASE_URL=https://api.typesafe.ai
JEV_ENABLED=false
JEV_SHADOW_ENABLED=false
JEV_MODEL=jev-latest
JEV_STAGE_INPUT_TOKEN_CAP=200000
JEV_STAGE_REQUEST_CAP=30
AGENT_MAX_TOOL_ROUNDS=5
AGENT_TIMEOUT_SECONDS=45
AGENT_TOTAL_DEADLINE_SECONDS=90
AGENT_CONVERSATION_TTL_MINUTES=1440
AGENT_CONVERSATION_CLEANUP_GRACE_DAYS=7
AGENT_DETERMINISTIC_MATERIAL_RESOLUTION_ENABLED=false
AGENT_ENGINEERING_RESEARCH_ENABLED=true

# Real-Qwen Eval（仅由显式 eval profile / 本地命令使用）
EVAL_RUN_REAL_QWEN=false
EVAL_MODEL=qwen3.6-flash
EVAL_MODELS=qwen3.6-flash,qwen3.7-flash
EVAL_FREE_MODEL_ALLOWLIST=qwen3.6-flash,qwen3.7-flash
EVAL_DASHSCOPE_API_KEY=
EVAL_ENABLE_THINKING=false
EVAL_GOLDEN_VERSION=v1.1
EVAL_MAX_TOKENS_PER_MODEL_STAGE=160000
EVAL_MAX_TOKENS_PER_MODEL_TOTAL=160000
EVAL_MAX_TOKENS_ALL_MODELS=320000
EVAL_EVALUATOR_COMMIT=

# Production Shadow Eval（默认关闭；产物仅保存到 backend/.local-evals/）
SHADOW_EVAL_ENABLED=false
SHADOW_EVAL_SEED=20260827
SHADOW_EVAL_MAX_CASES=60
SHADOW_EVAL_MODEL=
SHADOW_EVAL_OUTPUT_DIR=.local-evals/production-shadow

# Component Intelligence Foundation（只读，默认关闭）
COMPONENT_INTELLIGENCE_ENABLED=false
TRACEABLE_ENGINEERING_EVIDENCE_REQUIRED=true

# Portfolio Demo v2（仅显式一次性 seed 命令使用，默认关闭）
PORTFOLIO_DEMO_SEED_ENABLED=false
PORTFOLIO_CABLE_SEED_ENABLED=false

# Portfolio Demo 基线恢复（仅离线运维脚本读取，默认关闭；不会传入 Web 应用）
PORTFOLIO_DEMO_RESET_ENABLED=false

# Double gate for the destructive Phase 2.2 portfolio business-data rebuild.
# Keep false during normal operation; the rebuild script also requires an explicit CLI flag.
PORTFOLIO_DATABASE_REBUILD_ENABLED=false
PORTFOLIO_RELATION_SEED_ENABLED=false

  "cards": [
    {
      "dot": "cyan",
      "title": "Runtime surfaces",
      "items": [
        "Floating robot and /agent share the same structured server entities",
        "Nginx exposes one browser entry while FastAPI owns auth and business APIs"
      ]
    },
    {
      "dot": "emerald",
      "title": "Truth ownership",
      "items": [
        "Deterministic services own inventory, BOM, provenance, selection and preview facts",
        "The LLM explains grounded facts; it does not create transaction truth"
      ]
    },
    {
      "dot": "amber",
      "title": "Durability",
      "items": [
        "PostgreSQL stores business and agent context",
        "Files and evidence are backed up with a SHA-256 manifest before release"
      ]
    }
  ]

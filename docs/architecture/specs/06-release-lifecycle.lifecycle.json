{
  "schema_version": 1,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "Exact-SHA Release and Qualification Lifecycle",
    "quality_profile": "showcase",
    "viewBox": [
      1060,
      720
    ],
    "animation": "trace",
    "visual_preset": "signal-flow",
    "views": [
      {
        "id": "rail",
        "label": "Release rail",
        "focus": [
          "change",
          "verify",
          "candidate",
          "runtime",
          "ready"
        ],
        "note": "Every release advances from a clean change set to an exact-SHA runtime and release-ready proof."
      },
      {
        "id": "checks",
        "label": "Qualification evidence",
        "focus": [
          "ci",
          "backup",
          "browser",
          "note"
        ],
        "note": "CI, Memory Guard, backup, browser evidence and Git Notes stay bound to the same candidate SHA."
      },
      {
        "id": "fail",
        "label": "Explicit blockers",
        "focus": [
          "blocked",
          "queued"
        ],
        "note": "Infrastructure queues and semantic failures are reported truthfully rather than being converted into product changes."
      }
    ]
  },
  "lanes": [
    {
      "id": "main",
      "label": "Promotion rail"
    },
    {
      "id": "checks",
      "label": "Evidence gates"
    },
    {
      "id": "terminal",
      "label": "Blocked / pending"
    }
  ],
  "states": [
    {
      "id": "change",
      "type": "start",
      "label": "Change Set",
      "sublabel": "scoped change",
      "lane": "main",
      "col": 0,
      "step": "01",
      "tag": "tracked clean"
    },
    {
      "id": "verify",
      "type": "active",
      "label": "Local Verify",
      "sublabel": "tests + memory",
      "lane": "main",
      "col": 1,
      "step": "02",
      "tag": "finish gate"
    },
    {
      "id": "candidate",
      "type": "decision",
      "label": "Candidate SHA",
      "sublabel": "normal push",
      "lane": "main",
      "col": 2,
      "step": "03",
      "tag": "immutable"
    },
    {
      "id": "runtime",
      "type": "active",
      "label": "Exact-SHA Runtime",
      "sublabel": "backup + deploy",
      "lane": "main",
      "col": 3,
      "step": "04",
      "tag": "healthy"
    },
    {
      "id": "ready",
      "type": "success",
      "label": "Release Ready",
      "sublabel": "all gates green",
      "lane": "main",
      "col": 4,
      "step": "05",
      "tag": "qualified"
    },
    {
      "id": "ci",
      "type": "waiting",
      "label": "CI + Memory Guard",
      "sublabel": "exact SHA",
      "lane": "checks",
      "col": 0,
      "tag": "required"
    },
    {
      "id": "backup",
      "type": "active",
      "label": "Fresh Backup",
      "sublabel": "DB + files",
      "lane": "checks",
      "col": 1,
      "tag": "verified"
    },
    {
      "id": "browser",
      "type": "active",
      "label": "Browser Evidence",
      "sublabel": "semantic + parity",
      "lane": "checks",
      "col": 2,
      "tag": "dual surface"
    },
    {
      "id": "note",
      "type": "success",
      "label": "Qualification Note",
      "sublabel": "release gate",
      "lane": "checks",
      "col": 2,
      "yOffset": 95,
      "tag": "Git Notes"
    },
    {
      "id": "queued",
      "type": "waiting",
      "label": "Runner Queued",
      "sublabel": "infra pending",
      "lane": "terminal",
      "col": 0,
      "tag": "not failure"
    },
    {
      "id": "blocked",
      "type": "failure",
      "label": "Blocked",
      "sublabel": "semantic fail",
      "lane": "terminal",
      "col": 2,
      "tag": "stop promotion",
      "width": 150
    }
  ],
  "transitions": [
    {
      "from": "candidate",
      "to": "ci",
      "variant": "dashed",
      "fromSide": "bottom",
      "toSide": "top",
      "route": "straight"
    },
    {
      "from": "ci",
      "to": "queued",
      "variant": "dashed",
      "fromSide": "bottom",
      "toSide": "top",
      "route": "straight"
    },
    {
      "from": "runtime",
      "to": "backup",
      "variant": "dashed",
      "fromSide": "bottom",
      "toSide": "top",
      "route": "straight"
    },
    {
      "from": "browser",
      "to": "note",
      "variant": "emphasis",
      "fromSide": "bottom",
      "toSide": "top",
      "route": "straight"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Same-SHA rule",
      "items": [
        "Candidate, CI, runtime, browser evidence and qualification must reference one SHA",
        "Old screenshots or old green workflows never qualify a new candidate"
      ]
    },
    {
      "dot": "amber",
      "title": "Infrastructure truth",
      "items": [
        "A queued self-hosted job is pending infrastructure, not a product failure",
        "Runner health is repaired without changing product code"
      ]
    },
    {
      "dot": "emerald",
      "title": "Release ready",
      "items": [
        "Release Gate V2 requires CI and Memory Guard success, verified backup, healthy exact-SHA runtime and qualification evidence"
      ]
    }
  ]
}

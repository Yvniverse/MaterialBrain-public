{
  "compilerOptions": {
    "target": "ES2022", "useDefineForClassFields": true, "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noEmit": true, "jsx": "preserve", "resolveJsonModule": true, "isolatedModules": true, "esModuleInterop": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "skipLibCheck": true, "types": ["vitest/globals"]
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "tests/**/*.ts"]
}
